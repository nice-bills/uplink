{
  "version": 2,
  "name": "genesis-frontend",
  "builds": [
    {
      "src": "frontend-vite/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "frontend-vite/dist"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
