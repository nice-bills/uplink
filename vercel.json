# Vercel Configuration
# This file tells Vercel how to build and deploy the frontend

{
  "version": 2,
  "name": "genesis-frontend",
  "builds": [
    {
      "src": "frontend-vite/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "frontend-vite/dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "frontend-vite/dist/$1"
    }
  ],
  "env": {
    "VITE_API_URL": "https://genesis-backend.onrender.com",
    "VITE_MONAD_RPC_URL": "https://testnet-rpc.monad.xyz",
    "VITE_WALLETCONNECT_PROJECT_ID": "9030283b4cab3d66c6858fa008a96e45"
  }
}
